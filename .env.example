# Copia este archivo a ".env" (o deja que el bridge lo cree).

# Puerto en el que corre el bridge (deja 3000 salvo que ya lo uses para otra cosa)
PORT=3000

# Token secreto: la primera vez que arrancas el bridge se abre una ventana para
# escribirlo o generarlo y se guarda aquí. El juego lo recibe solo, no hay que
# copiarlo en Roblox. Para cambiarlo: npm run token
ACCESS_TOKEN=

# Dirección del WebSocket local de Tikfinity. El valor por defecto ya es el
# correcto mientras Tikfinity Desktop esté corriendo en este mismo PC.
TIKFINITY_URL=ws://127.0.0.1:21213/