# Configuración del servidor ONLINE (online.js). En el VPS se copia a online.env
# (el script vps/instalar.sh lo hace solo y genera ADMIN_KEY).

# Puerto interno (nginx recibe el HTTPS y lo pasa aquí)
PORT=8080
HOST=127.0.0.1

# Id del juego en Roblox (el botón "▶ ABRIR EL JUEGO" del panel abre este juego)
PLACE_ID=77774451323374

# Cuántos streamers (cuentas) como máximo
MAX_CHANNELS=300

# Clave para soporte (borrar la cuenta de alguien que olvidó su contraseña). Vacía = desactivado.
ADMIN_KEY=

# 1 = el log muestra cada regalo y seguidor de todos los canales
VERBOSE=0
