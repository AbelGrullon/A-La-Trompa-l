# Copia este archivo a ".env" y completa tus datos.

# Puerto en el que corre el bridge (déjalo así salvo que ya uses el 3000 para otra cosa)
PORT=3000

# Clave secreta inventada por ti, para que solo tu juego de Roblox pueda leer la cola.
ACCESS_TOKEN=Elmejorenesto07

# Dirección del WebSocket local de Tikfinity. El valor por defecto ya es el correcto
# mientras Tikfinity Desktop esté corriendo en esta misma computadora — normalmente
# no hace falta tocar esta línea.
TIKFINITY_URL=ws://127.0.0.1:21213/

# Cuántos milisegundos deben pasar antes de que el mismo username pueda volver a
# entrar a la cola (evita que alguien lo spamee en el chat). 60000 = 1 minuto.
REJOIN_COOLDOWN_MS=60000
